# Copy to client/.env

# `mock`  -> whole site runs from the bundled menu data (no backend needed)
# `live`  -> read menu/offers/reviews/settings from the content API at VITE_API_URL
VITE_API_MODE=mock
VITE_API_URL=http://localhost:5050/api

# Public site URL (used for canonical tags + sitemap)
VITE_SITE_URL=https://thebyteclub.example

# Google Maps embed src for the Contact page (optional)
VITE_MAPS_EMBED_URL=
