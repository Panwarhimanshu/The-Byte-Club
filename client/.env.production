# Production build (Vercel). No secrets here — Vite inlines VITE_* into the bundle.
# The API is served from the same origin, so a relative URL keeps this working on
# preview deploys and custom domains alike.
VITE_API_MODE=live
VITE_API_URL=/api
VITE_SITE_URL=https://thebyteclub.vercel.app
VITE_MAPS_EMBED_URL=
