{
  "name": "the-byte-club",
  "version": "1.0.0",
  "private": true,
  "description": "THE BYTE CLUB — a digital-first fast-food brand. Monorepo (React + Vite client, Express + MongoDB API).",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace server",
    "dev:web": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "lint": "npm run lint --workspace client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
