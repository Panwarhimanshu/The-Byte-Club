# ─────────────────────────────────────────────────────────────
#  THE BYTE CLUB — server environment template
#  Copy to `.env` at the repo root. The client reads its own
#  client/.env — see client/.env.example
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5050
CLIENT_URL=http://localhost:5173

# --- Database ---
# Leave MONGO_URI blank in dev to auto-boot an in-memory MongoDB
# (first run downloads a ~50 MB binary, then cached). Or point it at
# a local Mongo / MongoDB Atlas SRV string.
MONGO_URI=
USE_MEMORY_DB=true

# --- Admin panel auth (JWT) ---
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-long-random-string
ADMIN_NAME=Byte Admin
ADMIN_EMAIL=admin@thebyteclub.com
ADMIN_PASSWORD=change-me

# --- Misc ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
